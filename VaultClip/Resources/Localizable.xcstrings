            "value": "즐겨찾기 및 저장된 비밀번호는 모든 항목과 함께 유지되거나 제거될 수 있습니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mėgstamiausius ir išsaugotus slaptažodžius galima laikyti arba pašalinti kartu su visais elementais."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Izlases un saglabātās paroles var saglabāt vai noņemt kopā ar visiem vienumiem."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kegemaran dan kata laluan yang disimpan boleh disimpan atau dialih keluar bersama-sama dengan semua item."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Favoritter og lagrede passord kan beholdes eller fjernes sammen med alle elementer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Favorieten en opgeslagen wachtwoorden kunnen samen met alle items worden bewaard of verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ulubione i zapisane hasła można zachować lub usunąć razem ze wszystkimi elementami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Favoritos e senhas salvas podem ser mantidos ou removidos junto com todos os itens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Favoritos e senhas salvas podem ser mantidos ou removidos junto com todos os itens."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Favoritele și parolele salvate pot fi păstrate sau eliminate împreună cu toate elementele."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Obľúbené položky a uložené heslá možno ponechať alebo odstrániť spolu so všetkými položkami."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Priljubljene in shranjena gesla lahko obdržite ali odstranite skupaj z vsemi elementi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Favoriter och sparade lösenord kan behållas eller tas bort tillsammans med alla objekt."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "பிடித்தவை மற்றும் சேமித்த கடவுச்சொற்களை அனைத்து பொருட்களுடன் சேர்த்து வைக்கலாம் அல்லது அகற்றலாம்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ఇష్టమైనవి మరియు సేవ్ చేసిన పాస్‌వర్డ్‌లను అన్ని అంశాలతో కలిపి ఉంచవచ్చు లేదా తీసివేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "รายการโปรดและรหัสผ่านที่บันทึกไว้สามารถเก็บหรือลบออกพร้อมกับรายการทั้งหมดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Favoriler ve kayıtlı şifreler tüm öğelerle birlikte saklanabilir veya kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
