      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VaultClip — GNU GPL v3 or later.\nBased on Yippy by Matthew Davidson (MIT), https://github.com/mattDavo/Yippy\nFork and modifications: Aleksey Karakuts — aleksey@karakuts.com\nhttps://github.com/akarakuts/VaultClip"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VaultClip — GNU GPL v3 или новее.\nНа основе Yippy Matthew Davidson (MIT), https://github.com/mattDavo/Yippy\nФорк и доработки: Aleksey Karakuts — aleksey@karakuts.com\nhttps://github.com/akarakuts/VaultClip"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip — الإصدار الثالث من GNU GPL أو الإصدارات الأحدث.\nاستنادًا إلى Yippy لماثيو ديفيدسون (MIT)، https://github.com/mattDavo/Yippy\nالشوكة والتعديلات: أليكسي كاراكوتس — aleksey@karakuts.com\nhttps://github.com/akarakuts/VaultClip"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip — GNU GPL v3 или по-нова версия.\nВъз основа на Yippy от Матю Дейвидсън (MIT), https://github.com/mattDavo/Yippy\nФорк и модификации: Алексей Каракуц — aleksey@karakuts.com\nhttps://github.com/akarakuts/VaultClip"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ভল্টক্লিপ — GNU GPL v3 বা পরবর্তী।\nম্যাথিউ ডেভিডসন (MIT), https://github.com/mattDavo/Yippy দ্বারা Yippy-এর উপর ভিত্তি করে\nকাঁটাচামচ এবং পরিবর্তন: আলেক্সি কারাকুটস — aleksey@karakuts.com\nhttps://github.com/akarakuts/VaultClip"
          }
        },
        "ca": {
          "stringUnit": {
