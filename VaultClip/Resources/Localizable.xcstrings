    "encryption.keychain_denied": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keychain denied access to the encryption key. Open Keychain Access, find the entry \"%@\" for VaultClip, and allow access for this application."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Связка ключей отклонила доступ к ключу. Откройте «Связку ключей», найдите запись «%@» для VaultClip и разрешите доступ этому приложению."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "رفضت Keychain الوصول إلى مفتاح التشفير. افتح Keychain Access، وابحث عن الإدخال \"%@\" لـ VaultClip، واسمح بالوصول لهذا التطبيق."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Keychain отказа достъп до ключа за шифроване. Отворете Keychain Access, намерете записа „%@“ за VaultClip и разрешете достъп за това приложение."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
