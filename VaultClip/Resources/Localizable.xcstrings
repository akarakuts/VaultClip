    "welcome.body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For VaultClip to be able to paste into your applications it requires you to provide it with full control to your computer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы VaultClip мог вставлять текст в ваши приложения, ему нужен полный контроль компьютера (Универсальный доступ)."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "لكي يتمكن VaultClip من اللصق في تطبيقاتك، فإنه يتطلب منك تزويده بالتحكم الكامل في جهاز الكمبيوتر الخاص بك."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "За да може VaultClip да поставя във вашите приложения, трябва да му предоставите пълен контрол на вашия компютър."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip আপনার অ্যাপ্লিকেশনগুলিতে পেস্ট করতে সক্ষম হওয়ার জন্য আপনাকে এটিকে আপনার কম্পিউটারে সম্পূর্ণ নিয়ন্ত্রণ প্রদান করতে হবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perquè VaultClip es pugui enganxar a les vostres aplicacions, cal que li proporcioneu un control total al vostre ordinador."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby bylo možné VaultClip vkládat do vašich aplikací, musíte mu poskytnout plnou kontrolu nad počítačem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For at VaultClip skal kunne indsætte i dine applikationer, kræver det, at du giver den fuld kontrol til din computer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Damit VaultClip in Ihre Anwendungen eingefügt werden kann, müssen Sie ihm die volle Kontrolle über Ihren Computer gewähren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Για να είναι δυνατή η επικόλληση του VaultClip στις εφαρμογές σας, απαιτείται να του παρέχετε τον πλήρη έλεγχο στον υπολογιστή σας."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For VaultClip to be able to paste into your applications it requires you to provide it with full control to your computer."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For VaultClip to be able to paste into your applications it requires you to provide it with full control to your computer."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For VaultClip to be able to paste into your applications it requires you to provide it with full control to your computer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para que VaultClip pueda pegar en sus aplicaciones, es necesario que le proporcione control total en su computadora."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para que VaultClip pueda pegar en sus aplicaciones, es necesario que le proporcione control total en su computadora."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para que VaultClip pueda pegar en sus aplicaciones, es necesario que le proporcione control total en su computadora."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Jotta VaultClip voi liittää sovelluksiisi, se edellyttää, että annat sille täyden hallinnan tietokoneellesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour que VaultClip puisse être collé dans vos applications, vous devez lui fournir un contrôle total sur votre ordinateur."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pour que VaultClip puisse être collé dans vos applications, vous devez lui fournir un contrôle total sur votre ordinateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "כדי ש-VaultClip תוכל להדביק באפליקציות שלך, זה דורש ממך לספק לו שליטה מלאה למחשב שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वॉल्टक्लिप को आपके एप्लिकेशन में पेस्ट करने में सक्षम होने के लिए आपको इसे अपने कंप्यूटर पर पूर्ण नियंत्रण प्रदान करना आवश्यक है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da bi se VaultClip mogao zalijepiti u vaše aplikacije, potrebno je da mu omogućite potpunu kontrolu nad vašim računalom."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ahhoz, hogy a VaultClip be tudjon illeszteni az alkalmazásaiba, teljes körű vezérlést kell biztosítania a számítógépe számára."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Agar VaultClip dapat menempel ke aplikasi Anda, Anda harus memberikan kontrol penuh pada komputer Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Affinché VaultClip possa incollarlo nelle tue applicazioni è necessario fornirgli il pieno controllo sul tuo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip をアプリケーションに貼り付けるには、コンピュータに対する完全な制御を VaultClip に提供する必要があります。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip қолданбаларыңызға қоя алуы үшін оны компьютерге толық басқаруды қамтамасыз ету қажет."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip을 귀하의 응용프로그램에 붙여넣을 수 있으려면 귀하의 컴퓨터에 대한 모든 권한을 제공해야 합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kad „VaultClip“ galėtų įklijuoti į jūsų programas, turite suteikti jam visišką kompiuterio valdymą."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lai VaultClip varētu ielīmēt jūsu lietojumprogrammās, jums ir jānodrošina pilnīga datora kontrole."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Untuk VaultClip dapat menampal ke dalam aplikasi anda, anda memerlukannya untuk menyediakannya dengan kawalan penuh kepada komputer anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "For at VaultClip skal kunne lime inn i programmene dine, krever det at du gir den full kontroll til datamaskinen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Om VaultClip in uw toepassingen te kunnen plakken, moet u het volledige controle over uw computer geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby VaultClip mógł wklejać się do twoich aplikacji, musisz zapewnić mu pełną kontrolę nad swoim komputerem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para que o VaultClip possa ser colado em seus aplicativos, é necessário que você forneça controle total ao seu computador."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para que o VaultClip possa ser colado em seus aplicativos, é necessário que você forneça controle total ao seu computador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pentru ca VaultClip să poată lipi în aplicațiile dvs., este necesar să îi oferiți control deplin computerului."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aby bolo možné VaultClip prilepiť do vašich aplikácií, musíte mu poskytnúť plnú kontrolu nad počítačom."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Da bi VaultClip lahko prilepil v vaše aplikacije, morate zagotoviti popoln nadzor nad vašim računalnikom."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "För att VaultClip ska kunna klistra in i dina applikationer krävs att du ger den full kontroll till din dator."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip உங்கள் பயன்பாடுகளில் ஒட்டுவதற்கு, அதை உங்கள் கணினியில் முழு கட்டுப்பாட்டுடன் வழங்க வேண்டும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "వాల్ట్‌క్లిప్ మీ అప్లికేషన్‌లలో అతికించగలిగేలా చేయడానికి, మీ కంప్యూటర్‌కు పూర్తి నియంత్రణను అందించడం అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เพื่อให้ VaultClip สามารถวางลงในแอปพลิเคชันของคุณได้ คุณจะต้องให้การควบคุมคอมพิวเตอร์ของคุณเต็มรูปแบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip'in uygulamalarınıza yapıştırılabilmesi için, ona bilgisayarınızda tam kontrol sağlamanız gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Щоб VaultClip міг вставляти у ваші програми, вам потрібно надати повний контроль комп’ютеру."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Để VaultClip có thể dán vào ứng dụng của bạn, bạn phải cung cấp cho VaultClip toàn quyền kiểm soát máy tính của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为了使 VaultClip 能够粘贴到您的应用程序中，您需要为其提供对计算机的完全控制权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "為了使 VaultClip 能夠貼上到您的應用程式中，您需要為其提供對電腦的完全控制權。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "為了使 VaultClip 能夠貼上到您的應用程式中，您需要為其提供對電腦的完全控制權。"
          }
        }
      }
    },
