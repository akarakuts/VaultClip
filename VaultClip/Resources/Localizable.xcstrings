    "encryption.decrypt_body": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VaultClip found encrypted history but no matching encryption key. This can happen after an interrupted update or if the Keychain entry was removed.\n\nQuit and restore ~/Library/Application Support/com.karakuts.VaultClip from a backup, or start with an empty history."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "VaultClip нашёл зашифрованную историю, но нет подходящего ключа. Так бывает после прерванного обновления или удаления записи из Связки ключей.\n\nЗавершите работу и восстановите ~/Library/Application Support/com.karakuts.VaultClip из резервной копии или начните с пустой истории."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "عثر VaultClip على سجل مشفر ولكن لا يوجد مفتاح تشفير مطابق. يمكن أن يحدث هذا بعد توقف التحديث أو في حالة إزالة إدخال Keychain.\n\nقم بإنهاء واستعادة ~/Library/Application Support/com.karakuts.VaultClip من نسخة احتياطية، أو ابدأ بسجل فارغ."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip намери криптирана история, но няма съответстващ ключ за криптиране. Това може да се случи след прекъсната актуализация или ако записът Keychain е премахнат.\n\nИзлезте и възстановете ~/Library/Application Support/com.karakuts.VaultClip от резервно копие или започнете с празна хронология."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip এনক্রিপ্ট করা ইতিহাস পাওয়া গেছে কিন্তু কোনো মিলিত এনক্রিপশন কী নেই। এটি একটি বিঘ্নিত আপডেটের পরে বা কীচেন এন্ট্রি সরানো হলে ঘটতে পারে।\n\nপ্রস্থান করুন এবং একটি ব্যাকআপ থেকে ~/Library/Application Support/com.karakuts.VaultClip পুনরুদ্ধার করুন বা একটি খালি ইতিহাস দিয়ে শুরু করুন৷"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip ha trobat l'historial xifrat però no hi ha cap clau de xifratge coincident. Això pot passar després d'una actualització interrompuda o si s'ha eliminat l'entrada del clauer.\n\nSortiu i restaura ~/Library/Application Support/com.karakuts.VaultClip des d'una còpia de seguretat o comença amb un historial buit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip nalezl zašifrovanou historii, ale žádný odpovídající šifrovací klíč. K tomu může dojít po přerušené aktualizaci nebo pokud byl záznam Keychain odstraněn.\n\nUkončete a obnovte ~/Library/Application Support/com.karakuts.VaultClip ze zálohy nebo začněte s prázdnou historií."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip fandt krypteret historik, men ingen matchende krypteringsnøgle. Dette kan ske efter en afbrudt opdatering, eller hvis nøgleringen blev fjernet.\n\nAfslut og gendan ~/Library/Application Support/com.karakuts.VaultClip fra en sikkerhedskopi, eller start med en tom historie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip hat einen verschlüsselten Verlauf gefunden, aber keinen passenden Verschlüsselungsschlüssel. Dies kann nach einem unterbrochenen Update passieren oder wenn der Schlüsselbundeintrag entfernt wurde.\n\nBeenden Sie ~/Library/Application Support/com.karakuts.VaultClip und stellen Sie es aus einem Backup wieder her oder beginnen Sie mit einem leeren Verlauf."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Το VaultClip βρήκε κρυπτογραφημένο ιστορικό αλλά κανένα κλειδί κρυπτογράφησης που να ταιριάζει. Αυτό μπορεί να συμβεί μετά από μια διακοπείσα ενημέρωση ή εάν καταργήθηκε η καταχώρηση Keychain.\n\nΚλείστε και επαναφέρετε το ~/Library/Application Support/com.karakuts.VaultClip από ένα αντίγραφο ασφαλείας ή ξεκινήστε με ένα κενό ιστορικό."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip found encrypted history but no matching encryption key. This can happen after an interrupted update or if the Keychain entry was removed.\n\nQuit and restore ~/Library/Application Support/com.karakuts.VaultClip from a backup, or start with an empty history."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip found encrypted history but no matching encryption key. This can happen after an interrupted update or if the Keychain entry was removed.\n\nQuit and restore ~/Library/Application Support/com.karakuts.VaultClip from a backup, or start with an empty history."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip found encrypted history but no matching encryption key. This can happen after an interrupted update or if the Keychain entry was removed.\n\nQuit and restore ~/Library/Application Support/com.karakuts.VaultClip from a backup, or start with an empty history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip encontró un historial cifrado pero no una clave de cifrado coincidente. Esto puede suceder después de una actualización interrumpida o si se eliminó la entrada del Llavero.\n\nSalga y restaure ~/Library/Application Support/com.karakuts.VaultClip desde una copia de seguridad, o comience con un historial vacío."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip encontró un historial cifrado pero no una clave de cifrado coincidente. Esto puede suceder después de una actualización interrumpida o si se eliminó la entrada del Llavero.\n\nSalga y restaure ~/Library/Application Support/com.karakuts.VaultClip desde una copia de seguridad, o comience con un historial vacío."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip encontró un historial cifrado pero no una clave de cifrado coincidente. Esto puede suceder después de una actualización interrumpida o si se eliminó la entrada del Llavero.\n\nSalga y restaure ~/Library/Application Support/com.karakuts.VaultClip desde una copia de seguridad, o comience con un historial vacío."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip löysi salatun historian, mutta ei vastaavaa salausavainta. Tämä voi tapahtua keskeytyneen päivityksen jälkeen tai jos Keychain-merkintä on poistettu.\n\nLopeta ja palauta ~/Library/Application Support/com.karakuts.VaultClip varmuuskopiosta tai aloita tyhjästä historiasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip a trouvé un historique chiffré mais aucune clé de chiffrement correspondante. Cela peut se produire après une mise à jour interrompue ou si l'entrée du trousseau a été supprimée.\n\nQuittez et restaurez ~/Library/Application Support/com.karakuts.VaultClip à partir d'une sauvegarde, ou démarrez avec un historique vide."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip a trouvé un historique chiffré mais aucune clé de chiffrement correspondante. Cela peut se produire après une mise à jour interrompue ou si l'entrée du trousseau a été supprimée.\n\nQuittez et restaurez ~/Library/Application Support/com.karakuts.VaultClip à partir d'une sauvegarde, ou démarrez avec un historique vide."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip מצא היסטוריה מוצפנת אך ללא מפתח הצפנה תואם. זה יכול לקרות לאחר עדכון שנקטע או אם הערך של מחזיק מפתחות הוסר.\n\nצא ושחזר את ~/Library/Application Support/com.karakuts.VaultClip מגיבוי, או התחל עם היסטוריה ריקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "वॉल्टक्लिप को एन्क्रिप्टेड इतिहास मिला लेकिन कोई मेल खाती एन्क्रिप्शन कुंजी नहीं मिली। ऐसा किसी बाधित अद्यतन के बाद या किचेन प्रविष्टि हटा दिए जाने पर हो सकता है।\n\n~/Library/Application Support/com.karakuts.VaultClip को बैकअप से छोड़ें और पुनर्स्थापित करें, या एक खाली इतिहास के साथ शुरू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip je pronašao šifriranu povijest, ali ne i odgovarajući ključ za šifriranje. To se može dogoditi nakon prekinutog ažuriranja ili ako je unos Keychain uklonjen.\n\nZatvorite i vratite ~/Library/Application Support/com.karakuts.VaultClip iz sigurnosne kopije ili počnite s praznom poviješću."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A VaultClip titkosított előzményeket talált, de nem talált megfelelő titkosítási kulcsot. Ez akkor fordulhat elő, ha megszakad a frissítés, vagy ha a Keychain bejegyzést eltávolították.\n\nLépjen ki és állítsa vissza a ~/Library/Application Support/com.karakuts.VaultClip-et biztonsági másolatból, vagy kezdje üres előzményekkel."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip menemukan riwayat terenkripsi tetapi tidak ada kunci enkripsi yang cocok. Hal ini dapat terjadi setelah pembaruan terputus atau jika entri Rantai Kunci telah dihapus.\n\nKeluar dan pulihkan ~/Library/Application Support/com.karakuts.VaultClip dari cadangan, atau mulai dengan riwayat kosong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip ha trovato la cronologia crittografata ma nessuna chiave di crittografia corrispondente. Ciò può verificarsi dopo un aggiornamento interrotto o se la voce del portachiavi è stata rimossa.\n\nEsci e ripristina ~/Library/Application Support/com.karakuts.VaultClip da un backup o inizia con una cronologia vuota."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip は暗号化された履歴を見つけましたが、一致する暗号化キーがありませんでした。これは、更新が中断された後、またはキーチェーン エントリが削除された場合に発生する可能性があります。\n\n終了してバックアップから ~/Library/Application Support/com.karakuts.VaultClip を復元するか、空の履歴から開始します。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip шифрланған тарихты тапты, бірақ сәйкес шифрлау кілті жоқ. Бұл үзілген жаңартудан кейін немесе Keychain жазбасы жойылған жағдайда орын алуы мүмкін.\n\nШығыңыз және ~/Library/Application Support/com.karakuts.VaultClip файлын сақтық көшірмеден қалпына келтіріңіз немесе бос тарихтан бастаңыз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip에서 암호화된 기록을 찾았지만 일치하는 암호화 키가 없습니다. 이는 업데이트가 중단된 후 또는 키체인 항목이 제거된 경우 발생할 수 있습니다.\n\n백업에서 ~/Library/Application Support/com.karakuts.VaultClip을 종료하고 복원하거나 빈 기록으로 시작합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„VaultClip“ aptiko užšifruotą istoriją, bet nėra atitinkamo šifravimo rakto. Taip gali nutikti nutrūkus naujinimui arba pašalinus raktų pakabuko įrašą.\n\nIšeikite ir atkurkite ~/Library/Application Support/com.karakuts.VaultClip iš atsarginės kopijos arba pradėkite nuo tuščios istorijos."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip atrada šifrētu vēsturi, bet nav atbilstošas ​​šifrēšanas atslēgas. Tas var notikt pēc atjaunināšanas pārtraukuma vai atslēgas ķēdes ieraksta noņemšanas.\n\nAizveriet un atjaunojiet ~/Library/Application Support/com.karakuts.VaultClip no dublējuma vai sāciet ar tukšu vēsturi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip menemui sejarah yang disulitkan tetapi tiada kunci penyulitan yang sepadan. Ini boleh berlaku selepas kemas kini yang terganggu atau jika entri Rantai Kunci telah dialih keluar.\n\nKeluar dan pulihkan ~/Library/Application Support/com.karakuts.VaultClip daripada sandaran, atau mulakan dengan sejarah kosong."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip fant kryptert historikk, men ingen samsvarende krypteringsnøkkel. Dette kan skje etter en avbrutt oppdatering eller hvis nøkkelringoppføringen ble fjernet.\n\nAvslutt og gjenopprett ~/Library/Application Support/com.karakuts.VaultClip fra en sikkerhetskopi, eller start med en tom historikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip heeft versleutelde geschiedenis gevonden, maar geen overeenkomende versleutelingssleutel. Dit kan gebeuren na een onderbroken update of als het sleutelhangeritem is verwijderd.\n\nSluit ~/Library/Application Support/com.karakuts.VaultClip af en herstel deze vanaf een back-up, of begin met een lege geschiedenis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip znalazł zaszyfrowaną historię, ale nie znalazł pasującego klucza szyfrowania. Może się to zdarzyć po przerwanej aktualizacji lub po usunięciu wpisu pęku kluczy.\n\nZakończ i przywróć plik ~/Library/Application Support/com.karakuts.VaultClip z kopii zapasowej lub rozpocznij od pustej historii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O VaultClip encontrou um histórico criptografado, mas nenhuma chave de criptografia correspondente. Isso pode acontecer após uma atualização interrompida ou se a entrada das Chaves tiver sido removida.\n\nSaia e restaure ~/Library/Application Support/com.karakuts.VaultClip de um backup ou comece com um histórico vazio."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O VaultClip encontrou um histórico criptografado, mas nenhuma chave de criptografia correspondente. Isso pode acontecer após uma atualização interrompida ou se a entrada das Chaves tiver sido removida.\n\nSaia e restaure ~/Library/Application Support/com.karakuts.VaultClip de um backup ou comece com um histórico vazio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip a găsit istoric criptat, dar nicio cheie de criptare corespunzătoare. Acest lucru se poate întâmpla după o actualizare întreruptă sau dacă intrarea Keychain a fost eliminată.\n\nIeșiți și restaurați ~/Library/Application Support/com.karakuts.VaultClip dintr-o copie de rezervă sau începeți cu un istoric gol."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip našiel zašifrovanú históriu, ale žiadny zodpovedajúci šifrovací kľúč. Môže sa to stať po prerušenej aktualizácii alebo ak bola položka Keychain odstránená.\n\nUkončite a obnovte ~/Library/Application Support/com.karakuts.VaultClip zo zálohy alebo začnite s prázdnou históriou."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip je našel šifrirano zgodovino, vendar nobenega ujemajočega šifrirnega ključa. To se lahko zgodi po prekinjeni posodobitvi ali če je bil vnos Keychain odstranjen.\n\nZaprite in obnovite ~/Library/Application Support/com.karakuts.VaultClip iz varnostne kopije ali začnite s prazno zgodovino."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip hittade krypterad historik men ingen matchande krypteringsnyckel. Detta kan hända efter en avbruten uppdatering eller om nyckelringen togs bort.\n\nAvsluta och återställ ~/Library/Application Support/com.karakuts.VaultClip från en säkerhetskopia, eller börja med en tom historik."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "வால்ட்கிளிப் மறைகுறியாக்கப்பட்ட வரலாற்றைக் கண்டறிந்தது, ஆனால் பொருந்தக்கூடிய குறியாக்க விசை இல்லை. குறுக்கிடப்பட்ட புதுப்பித்தலுக்குப் பிறகு அல்லது கீச்சின் உள்ளீடு அகற்றப்பட்டால் இது நிகழலாம்.\n\nகாப்புப்பிரதியிலிருந்து வெளியேறி, ~/Library/Application Support/com.karakuts.VaultClip ஐ மீட்டெடுக்கவும் அல்லது வெற்று வரலாற்றுடன் தொடங்கவும்."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip గుప్తీకరించిన చరిత్రను కనుగొంది కానీ సరిపోలే ఎన్‌క్రిప్షన్ కీ లేదు. ఇది అంతరాయం కలిగించిన నవీకరణ తర్వాత లేదా కీచైన్ ఎంట్రీ తీసివేయబడిన తర్వాత జరగవచ్చు.\n\nనిష్క్రమించి, బ్యాకప్ నుండి ~/Library/Application Support/com.karakuts.VaultClipని పునరుద్ధరించండి లేదా ఖాళీ చరిత్రతో ప్రారంభించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip พบประวัติที่เข้ารหัส แต่ไม่มีคีย์การเข้ารหัสที่ตรงกัน สิ่งนี้สามารถเกิดขึ้นได้หลังจากการอัพเดตที่ถูกขัดจังหวะหรือหากรายการพวงกุญแจถูกลบออก\n\nออกและกู้คืน ~/Library/Application Support/com.karakuts.VaultClip จากข้อมูลสำรอง หรือเริ่มต้นด้วยประวัติว่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip şifrelenmiş geçmiş buldu ancak eşleşen şifreleme anahtarı bulunamadı. Bu, kesintiye uğrayan bir güncellemeden sonra veya Anahtarlık girişi kaldırıldığında meydana gelebilir.\n\n~/Library/Application Support/com.karakuts.VaultClip'ten çıkın ve bir yedeklemeden geri yükleyin veya boş bir geçmişle başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip знайшов зашифровану історію, але немає відповідного ключа шифрування. Це може статися після перерваного оновлення або якщо було видалено запис Keychain.\n\nЗакрийте та відновіть ~/Library/Application Support/com.karakuts.VaultClip із резервної копії або почніть із пустої історії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip tìm thấy lịch sử mã hóa nhưng không có khóa mã hóa trùng khớp. Điều này có thể xảy ra sau khi cập nhật bị gián đoạn hoặc nếu mục nhập Chuỗi khóa bị xóa.\n\nThoát và khôi phục ~/Library/Application Support/com.karakuts.VaultClip từ bản sao lưu hoặc bắt đầu với một lịch sử trống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip 找到加密历史记录，但没有匹配的加密密钥。更新中断或钥匙串条目被删除后可能会发生这种情况。\n\n退出并从备份恢复 ~/Library/Application Support/com.karakuts.VaultClip，或从空历史记录开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip 找到加密歷史記錄，但沒有相符的加密金鑰。更新中斷或鑰匙圈條目被刪除後可能會發生這種情況。\n\n退出並從備份還原 ~/Library/Application Support/com.karakuts.VaultClip，或從空歷史記錄開始。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "VaultClip 找到加密歷史記錄，但沒有相符的加密金鑰。更新中斷或鑰匙圈條目被刪除後可能會發生這種情況。\n\n退出並從備份還原 ~/Library/Application Support/com.karakuts.VaultClip，或從空歷史記錄開始。"
          }
        }
      }
    },
