          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Các mục yêu thích và mật khẩu đã lưu có thể được giữ hoặc xóa cùng với tất cả các mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
