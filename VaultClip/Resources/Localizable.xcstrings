    "encryption.keychain_unlock": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock your Mac and try again. VaultClip needs Keychain access to read encrypted clipboard history."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте Mac и попробуйте снова. VaultClip нужен доступ к Связке ключей для чтения зашифрованной истории."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "افتح قفل جهاز Mac وحاول مرة أخرى. يحتاج VaultClip إلى الوصول إلى Keychain لقراءة سجل الحافظة المشفرة."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отключете вашия Mac и опитайте отново. VaultClip се нуждае от достъп до Keychain, за да прочете шифрованата история на клипборда."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "আপনার ম্যাক আনলক করুন এবং আবার চেষ্টা করুন। এনক্রিপ্ট করা ক্লিপবোর্ড ইতিহাস পড়ার জন্য VaultClip কে কীচেন অ্যাক্সেসের প্রয়োজন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desbloqueja el teu Mac i torna-ho a provar. VaultClip necessita accés al clauer per llegir l'historial xifrat del porta-retalls."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odemkněte svůj Mac a zkuste to znovu. VaultClip potřebuje ke čtení šifrované historie schránky přístup Keychain."
          }
        },
        "da": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lås din Mac op, og prøv igen. VaultClip har brug for nøgleringadgang for at læse krypteret klippebordshistorik."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entsperren Sie Ihren Mac und versuchen Sie es erneut. VaultClip benötigt Schlüsselbundzugriff, um den Verlauf der verschlüsselten Zwischenablage lesen zu können."
          }
        },
        "el": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ξεκλειδώστε το Mac σας και δοκιμάστε ξανά. Το VaultClip χρειάζεται πρόσβαση στο Keychain για να διαβάσει το κρυπτογραφημένο ιστορικό του προχείρου."
          }
        },
        "en-AU": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock your Mac and try again. VaultClip needs Keychain access to read encrypted clipboard history."
          }
        },
        "en-GB": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock your Mac and try again. VaultClip needs Keychain access to read encrypted clipboard history."
          }
        },
        "en-IN": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Unlock your Mac and try again. VaultClip needs Keychain access to read encrypted clipboard history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desbloquea tu Mac e inténtalo de nuevo. VaultClip necesita acceso a Llavero para leer el historial cifrado del portapapeles."
          }
        },
        "es-419": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desbloquea tu Mac e inténtalo de nuevo. VaultClip necesita acceso a Llavero para leer el historial cifrado del portapapeles."
          }
        },
        "es-US": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desbloquea tu Mac e inténtalo de nuevo. VaultClip necesita acceso a Llavero para leer el historial cifrado del portapapeles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Avaa Macin lukitus ja yritä uudelleen. VaultClip tarvitsee avainnipun pääsyn lukeakseen salattua leikepöydän historiaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déverrouillez votre Mac et réessayez. VaultClip a besoin d'un accès au trousseau pour lire l'historique crypté du presse-papiers."
          }
        },
        "fr-CA": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Déverrouillez votre Mac et réessayez. VaultClip a besoin d'un accès au trousseau pour lire l'historique crypté du presse-papiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "בטל את נעילת ה-Mac ונסה שוב. VaultClip זקוק לגישה של מחזיק מפתחות כדי לקרוא היסטוריית לוח מוצפנת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "अपना Mac अनलॉक करें और पुनः प्रयास करें। एन्क्रिप्टेड क्लिपबोर्ड इतिहास को पढ़ने के लिए वॉल्टक्लिप को किचेन एक्सेस की आवश्यकता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otključajte svoj Mac i pokušajte ponovno. VaultClip treba Keychain pristup za čitanje šifrirane povijesti međuspremnika."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Oldja fel Mac számítógépét, és próbálja újra. A VaultClipnek kulcstartó-hozzáférésre van szüksége a titkosított vágólapelőzmények olvasásához."
          }
        },
        "id": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka kunci Mac Anda dan coba lagi. VaultClip memerlukan akses Rantai Kunci untuk membaca riwayat papan klip terenkripsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sblocca il tuo Mac e riprova. VaultClip necessita dell'accesso al portachiavi per leggere la cronologia degli appunti crittografata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac のロックを解除して、もう一度試してください。 VaultClip では、暗号化されたクリップボード履歴を読み取るためにキーチェーン アクセスが必要です。"
          }
        },
        "kk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac құрылғысының құлпын ашып, әрекетті қайталаңыз. VaultClip шифрланған алмасу буферінің тарихын оқу үшін Keychain рұқсатын қажет етеді."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac을 잠금 해제하고 다시 시도하십시오. VaultClip은 암호화된 클립보드 기록을 읽으려면 키체인 액세스가 필요합니다."
          }
        },
        "lt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atrakinkite „Mac“ ir bandykite dar kartą. „VaultClip“ reikia „Keychain“ prieigos, kad būtų galima skaityti šifruotą iškarpinės istoriją."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Atbloķējiet savu Mac datoru un mēģiniet vēlreiz. VaultClip ir nepieciešama atslēgas piekariņa piekļuve, lai lasītu šifrētu starpliktuves vēsturi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Buka kunci Mac anda dan cuba lagi. VaultClip memerlukan akses Rantai Kunci untuk membaca sejarah papan keratan yang disulitkan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lås opp Mac-en og prøv igjen. VaultClip trenger nøkkelringtilgang for å lese kryptert utklippstavlehistorikk."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ontgrendel je Mac en probeer het opnieuw. VaultClip heeft sleutelhangertoegang nodig om de gecodeerde klembordgeschiedenis te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odblokuj komputer Mac i spróbuj ponownie. VaultClip potrzebuje dostępu do pęku kluczy, aby odczytać zaszyfrowaną historię schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desbloqueie o seu Mac e tente novamente. O VaultClip precisa de acesso às Chaves para ler o histórico criptografado da área de transferência."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Desbloqueie o seu Mac e tente novamente. O VaultClip precisa de acesso às Chaves para ler o histórico criptografado da área de transferência."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deblocați Mac-ul și încercați din nou. VaultClip are nevoie de acces la breloc pentru a citi istoricul clipboardului criptat."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odomknite svoj Mac a skúste to znova. Na čítanie zašifrovanej histórie schránky potrebuje VaultClip prístup Keychain."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Odklenite svoj Mac in poskusite znova. VaultClip potrebuje dostop Keychain za branje šifrirane zgodovine odložišča."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lås upp din Mac och försök igen. VaultClip behöver nyckelring åtkomst för att läsa krypterad urklippshistorik."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "needs_review",
            "value": "உங்கள் மேக்கைத் திறந்து மீண்டும் முயற்சிக்கவும். மறைகுறியாக்கப்பட்ட கிளிப்போர்டு வரலாற்றைப் படிக்க VaultClipக்கு Keychain அணுகல் தேவை."
          }
        },
        "te": {
          "stringUnit": {
            "state": "needs_review",
            "value": "మీ Macని అన్‌లాక్ చేసి, మళ్లీ ప్రయత్నించండి. గుప్తీకరించిన క్లిప్‌బోర్డ్ చరిత్రను చదవడానికి VaultClipకి కీచైన్ యాక్సెస్ అవసరం."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ปลดล็อค Mac ของคุณแล้วลองอีกครั้ง VaultClip ต้องการการเข้าถึงพวงกุญแจเพื่ออ่านประวัติคลิปบอร์ดที่เข้ารหัส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mac'inizin kilidini açın ve tekrar deneyin. VaultClip'in şifrelenmiş pano geçmişini okumak için Anahtar Zinciri erişimine ihtiyacı var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Розблокуйте свій Mac і повторіть спробу. VaultClip потребує доступу Keychain для читання зашифрованої історії буфера обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mở khóa máy Mac của bạn và thử lại. VaultClip cần quyền truy cập Chuỗi khóa để đọc lịch sử bảng tạm được mã hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "解锁您的 Mac，然后重试。 VaultClip 需要钥匙串访问才能读取加密的剪贴板历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "解鎖您的 Mac，然後再試一次。 VaultClip 需要鑰匙圈存取才能讀取加密的剪貼簿歷史記錄。"
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "解鎖您的 Mac，然後再試一次。 VaultClip 需要鑰匙圈存取才能讀取加密的剪貼簿歷史記錄。"
          }
        }
      }
    },
