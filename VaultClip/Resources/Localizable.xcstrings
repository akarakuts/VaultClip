          "stringUnit": {
            "state": "needs_review",
            "value": "沒有保存密碼。右鍵點選一個項目 → 儲存到密碼..."
          }
        },
        "zh-HK": {
          "stringUnit": {
            "state": "needs_review",
            "value": "沒有保存密碼。右鍵點選一個項目 → 儲存到密碼..."
